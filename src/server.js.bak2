  try {
    const rows = all(`
      SELECT s.*, m.name as master_name
      FROM schedule s
      LEFT JOIN masters m ON m.id = s.master_id
      ORDER BY s.master_id, s.day_of_week
    `);
    res.json({ schedule: rows });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

