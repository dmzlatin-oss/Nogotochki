// ============ PATCH /api/bookings/:id — перенос записи ============
app.patch('/api/bookings/:id', authenticateToken, (req, res) => {
  try {
    const bookingId = Number(req.params.id);
    const { start, end, status } = req.body || {};
    
    const b = get('SELECT * FROM bookings WHERE id = ?', [bookingId]);
    if (!b) return sendError(res, 404, 'NOT_FOUND', 'Запись не найдена');
    
    // Права доступа (как в GET /api/bookings/:id)
    const isClientOwner = req.user.role === 'client' && Number(req.user.id) === Number(b.client_id);
    const isMasterOf = req.user.role === 'master' && isMasterLinkedToMaster(req.user.id, b.master_id);
    const isAdmin = req.user.role === 'admin';
    
    if (!isClientOwner && !isMasterOf && !isAdmin) {
      return sendError(res, 404, 'NOT_FOUND', 'Запись не найдена');
    }
    
    // Статус может менять только admin
    if (status && isAdmin) {
      const validStatuses = ['active', 'cancelled', 'completed'];
      if (!validStatuses.includes(status)) return sendError(res, 400, 'VALIDATION', 'Некорректный статус');
      run('UPDATE bookings SET status = ? WHERE id = ?', [status, bookingId]);
      const updated = get('SELECT * FROM bookings WHERE id = ?', [bookingId]);
      return res.json({ booking: cleanBooking(updated) });
    }
    
    // Перенос (изменение времени) — может делать клиент (своя запись), мастер (своя запись), admin (любая)
    if (start && end) {
      const startD = new Date(start);
      const endD = new Date(end);
      if (isNaN(startD) || isNaN(endD) || endD <= startD) {
        return sendError(res, 400, 'VALIDATION', 'Некорректные дата/время');
      }
      if (startD.getTime() < Date.now() - 60000) {
        return sendError(res, 400, 'VALIDATION', 'Нельзя перенести в прошлое');
      }
      
      // Проверяем, что новый слот свободен (как при создании записи)
      const service = get('SELECT duration_min FROM services WHERE id = ?', [b.service_id]);
      if (!service) return sendError(res, 404, 'NOT_FOUND', 'Услуга не найдена');
      
      const expectedEnd = new Date(startD.getTime() + service.duration_min * 60000);
      if (Math.abs(expectedEnd.getTime() - endD.getTime()) > 60000) {
        return sendError(res, 400, 'VALIDATION', `Длительность должна быть ${service.duration_min} мин`);
      }
      
      // Проверяем конфликты (как в createBooking)
      const conflict = get(`SELECT id FROM bookings WHERE master_id = ? AND status = 'active' AND force_overlap = 0
        AND id != ? AND start_time < ? AND end_time > ?`, 
        [b.master_id, bookingId, endD.toISOString(), startD.toISOString()]);
      if (conflict) {
        return sendError(res, 409, 'SLOT_UNAVAILABLE', 'На это время уже есть активная запись');
      }
      
      // Проверяем, что вписывается в рабочие часы
      const dDow = new Date(startD.toISOString().slice(0, 10) + 'T00:00:00Z').getUTCDay();
      const schedRow = get('SELECT work_end FROM schedule WHERE master_id = ? AND day_of_week = ?', [b.master_id, dDow]);
      const mRow = get('SELECT work_end FROM masters WHERE id = ?', [b.master_id]);
      const dayEnd = (schedRow && schedRow.work_end) || (mRow && mRow.work_end) || '19:00';
      if (endD.toISOString().slice(11, 16) > dayEnd) {
        return sendError(res, 400, 'VALIDATION', `Услуга должна закончиться не позже ${dayEnd} (конец рабочего дня)`);
      }
      
      run('UPDATE bookings SET start_time = ?, end_time = ? WHERE id = ?', 
        [startD.toISOString(), endD.toISOString(), bookingId]);
      const updated = get('SELECT * FROM bookings WHERE id = ?', [bookingId]);
      return res.json({ booking: cleanBooking(updated) });
    }
    
    return sendError(res, 400, 'VALIDATION', 'Укажите start и end для переноса или status для изменения статуса');
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

// ============ ADMIN: управление расписанием ============
// Создать/обновить расписание мастера на день
app.post('/api/admin/schedule', authenticateToken, requireRole('admin'), (req, res) => {
  try {
    const { master_id, day_of_week, work_start, work_end } = req.body || {};
    if (!master_id || !day_of_week || !work_start || !work_end) {
      return sendError(res, 400, 'VALIDATION', 'Укажите master_id, day_of_week, work_start, work_end');
    }
    const master = get('SELECT id FROM masters WHERE id = ?', [master_id]);
    if (!master) return sendError(res, 404, 'NOT_FOUND', 'Мастер не найден');
    
    const ex = get('SELECT id FROM schedule WHERE master_id = ? AND day_of_week = ?', [master_id, day_of_week]);
    if (ex) {
      run('UPDATE schedule SET work_start = ?, work_end = ? WHERE id = ?', [work_start, work_end, ex.id]);
      return res.json({ ok: true, updated: true });
    }
    const r = run('INSERT INTO schedule (master_id, day_of_week, work_start, work_end) VALUES (?,?,?,?)',
      [master_id, day_of_week, work_start, work_end]);
    return res.status(201).json({ ok: true, scheduleId: Number(r.lastInsertRowid) });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

// Удалить запись расписания
app.delete('/api/admin/schedule/:id', authenticateToken, requireRole('admin'), (req, res) => {
  try {
    const id = Number(req.params.id);
    const ex = get('SELECT id FROM schedule WHERE id = ?', [id]);
    if (!ex) return sendError(res, 404, 'NOT_FOUND', 'Запись расписания не найдена');
    run('DELETE FROM schedule WHERE id = ?', [id]);
    return res.json({ ok: true });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

// ============ ADMIN: управление блокировками ============
// Создать блокировку
app.post('/api/admin/blocks', authenticateToken, requireRole('admin'), (req, res) => {
  try {
    const { master_id, start_time, end_time, reason } = req.body || {};
    if (!master_id || !start_time || !end_time) {
      return sendError(res, 400, 'VALIDATION', 'Укажите master_id, start_time, end_time');
    }
    const master = get('SELECT id FROM masters WHERE id = ?', [master_id]);
    if (!master) return sendError(res, 404, 'NOT_FOUND', 'Мастер не найден');
    
    // Проверяем, не пересекается ли с существующей блокировкой
    const ex = get('SELECT id FROM blocks WHERE master_id = ? AND start_time < ? AND end_time > ?',
      [master_id, end_time, start_time]);
    if (ex) return sendError(res, 409, 'OVERLAP', 'Пересекается с существующей блокировкой');
    
    const r = run('INSERT INTO blocks (master_id, start_time, end_time, reason) VALUES (?,?,?,?)',
      [master_id, start_time, end_time, reason || null]);
    return res.status(201).json({ ok: true, blockId: Number(r.lastInsertRowid) });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

// Удалить блокировку
app.delete('/api/admin/blocks/:id', authenticateToken, requireRole('admin'), (req, res) => {
  try {
    const id = Number(req.params.id);
    const ex = get('SELECT id FROM blocks WHERE id = ?', [id]);
    if (!ex) return sendError(res, 404, 'NOT_FOUND', 'Блокировка не найдена');
    run('DELETE FROM blocks WHERE id = ?', [id]);
    return res.json({ ok: true });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

// --- Статический файлы и SPA fallback (production) ---
const path = require('path');
const fs = require('fs');
const frontendDist = path.join(__dirname, '..', 'frontend', 'dist');
if (fs.existsSync(frontendDist)) {
  app.use(express.static(frontendDist));
  app.get('*', (req, res) => {
    res.sendFile(path.join(frontendDist, 'index.html'));
  });
  console.log('[booking-service] Static files served from', frontendDist);
}
// 404 fallback
app.use((req, res) => sendError(res, 404, 'NOT_FOUND', 'Маршрут не найден'));

const PORT = parseInt(process.env.PORT, 10) || 3000;
if (require.main === module) {
  app.listen(PORT, () => console.log(`[booking-service] listening on :${PORT}`));
}
module.exports = app;


