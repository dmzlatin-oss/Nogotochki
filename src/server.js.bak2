// src/server.js — API сервиса записи
const express = require('express');
const cors = require('cors');
const rateLimit = require('./ratelimit');
const { all, get, run } = require('./db');
const auth = require('./auth');
const { authenticateToken, requireRole, isOwner } = require('./middleware');
const { getFreeSlots, getFreeIntervals, getSlotStatuses } = require('./availability');
const { createBooking, cancelBooking } = require('./bookings');

const app = express();
app.use(express.json());
// CORS для dev-режима фронта (Vite на :5173). В prod на VPS фронт и /api
// отдаются одним nginx, CORS не нужен — но он безопасен (разрешаем любой origin,
// т.к. защита реализована токенами, а не CORS).
app.use(cors());

// --- Rate limit для auth-эндпоинтов (п.24) ---
const authLimiter = rateLimit({
  max: parseInt(process.env.RATE_LIMIT_MAX, 10) || 20,
  windowMs: parseInt(process.env.RATE_LIMIT_WINDOW_MS, 10) || 900000,
});

function cleanUser(u) {
  // никогда не возвращаем хеш/соль
  const { password_hash, password_salt, password_params, ...rest } = u;
  return rest;
}
function sendError(res, status, error, message, extra = {}) {
  res.status(status).json({ error, message, ...extra });
}

// ============ AUTH ============
app.post('/api/auth/register', authLimiter, (req, res) => {
  try {
    const { name, email, password } = req.body || {};
    if (!name || typeof name !== 'string' || name.trim().length < 2) return sendError(res, 400, 'VALIDATION', 'Имя обязательно (мин 2 символа)');
    if (!email || typeof email !== 'string' || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return sendError(res, 400, 'VALIDATION', 'Некорректный email');
    if (!password || typeof password !== 'string' || password.length < 8) return sendError(res, 400, 'VALIDATION', 'Пароль минимум 8 символов');
    const exists = get('SELECT id FROM users WHERE email = ?', [email.toLowerCase()]);
    if (exists) return sendError(res, 409, 'EMAIL_TAKEN', 'Пользователь с таким email уже существует');

    // Роль НЕ берём из body. Только client по умолчанию. (admin/master создаёт админ отдельно.)
    const { hash, salt, params } = auth.hashPassword(password);
    const r = run(
      'INSERT INTO users (name, email, password_hash, password_salt, password_params, role) VALUES (?, ?, ?, ?, ?, ?)',
      [name.trim(), email.toLowerCase(), hash, salt, params, 'client']
    );
    return res.status(201).json({ message: 'Аккаунт создан', userId: Number(r.lastInsertRowid) });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

app.post('/api/auth/login', authLimiter, (req, res) => {
  try {
    const { email, password } = req.body || {};
    if (!email || !password) return sendError(res, 400, 'VALIDATION', 'Email и пароль обязательны');
    const u = get('SELECT * FROM users WHERE email = ?', [String(email).toLowerCase()]);
    // Не раскрываем, существует ли пользователь. Общий ответ.
    if (!u || !auth.verifyPassword(password, u.password_salt, u.password_hash, u.password_params)) {
      return sendError(res, 401, 'INVALID_CREDENTIALS', 'Неверный email или пароль');
    }
    const token = auth.createToken();
    run('INSERT INTO tokens (user_id, token_hash, expires_at) VALUES (?, ?, ?)',
      [u.id, auth.hashToken(token), auth.tokenExpiryISO()]);
    return res.json({ token, user: cleanUser(u) });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

app.post('/api/auth/logout', authenticateToken, (req, res) => {
  try {
    // токен извлекаем и удаляем
    const token = require('./middleware').extractToken(req);
    if (token) run('DELETE FROM tokens WHERE token_hash = ?', [auth.hashToken(token)]);
    return res.json({ message: 'Выход выполнен' });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

app.get('/api/auth/me', authenticateToken, (req, res) => {
  const u = get('SELECT * FROM users WHERE id = ?', [req.user.id]);
  if (!u) return sendError(res, 401, 'UNAUTHORIZED', 'Пользователь не найден');
  return res.json({ user: cleanUser(u) });
});

// ============ SERVICES ============
app.get('/api/services', (req, res) => {
  const rows = all("SELECT id, name, description, duration_min, price, active FROM services WHERE active = 1 ORDER BY id");
  res.json({ services: rows });
});
app.get('/api/services/:id', (req, res) => {
  const s = get('SELECT id, name, description, duration_min, price, active FROM services WHERE id = ?', [req.params.id]);
  if (!s) return sendError(res, 404, 'NOT_FOUND', 'Услуга не найдена');
  res.json({ service: s });
});

// ============ MASTERS ============
app.get('/api/masters', (req, res) => {
  const rows = all('SELECT id, name, specialization, description, photo_url, work_start, work_end, active FROM masters WHERE active = 1 ORDER BY id');
  const links = all('SELECT master_id, service_id FROM master_services');
  const byMaster = {};
  for (const l of links) (byMaster[l.master_id] ||= []).push(l.service_id);
  res.json({ masters: rows.map((m) => ({ ...m, serviceIds: byMaster[m.id] || [] })) });
});
app.get('/api/masters/:id', (req, res) => {
  const m = get('SELECT id, name, specialization, description, photo_url, work_start, work_end, active FROM masters WHERE id = ?', [req.params.id]);
  if (!m) return sendError(res, 404, 'NOT_FOUND', 'Мастер не найден');
  res.json({ master: m });
});

// ============ AVAILABILITY (п.14) ============
app.get('/api/masters/:id/availability', (req, res) => {
  try {
    const masterId = req.params.id;
    const { date, serviceId } = req.query;
    if (!date || !/^\d{4}-\d{2}-\d{2}$/.test(date)) return sendError(res, 400, 'VALIDATION', 'Параметр date обязателен (YYYY-MM-DD)');
    let duration = 60;
    if (serviceId) {
      const s = get('SELECT duration_min FROM services WHERE id = ?', [serviceId]);
      if (!s) return sendError(res, 404, 'NOT_FOUND', 'Услуга не найдена');
      duration = s.duration_min;
    }
    const slots = getFreeSlots(masterId, date, duration);
    const slotStatuses = getSlotStatuses(Number(masterId), date, duration);
    const m = get('SELECT work_start, work_end FROM masters WHERE id = ?', [masterId]);
    res.json({ date, masterId: Number(masterId), durationMin: duration, slots, slotStatuses, workStart: m?.work_start || null, workEnd: m?.work_end || null });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

// ============ BOOKINGS ============
// Создание записи (п.16) — ОДНА общая функция для всех ролей
app.post('/api/bookings', authenticateToken, (req, res) => {
  try {
    const { serviceId, start, end } = req.body || {};
    let masterId = req.body.masterId;

    // Права определяются ДО проверки существования мастера (п.16).
    // client: masterId из body. master: только свой (body игнорируется). admin: masterId из body.
    if (req.user.role === 'master') {
      const myMaster = get('SELECT id FROM masters WHERE user_id = ?', [req.user.id]);
      if (!myMaster) return sendError(res, 403, 'FORBIDDEN', 'Мастер не привязан к профилю');
      masterId = myMaster.id;
    }
    if (!masterId || !serviceId || !start || !end) return sendError(res, 400, 'VALIDATION', 'masterId, serviceId, start, end обязательны');

    const master = get('SELECT id FROM masters WHERE id = ? AND active = 1', [masterId]);
    if (!master) return sendError(res, 404, 'NOT_FOUND', 'Мастер не найден');
    const service = get('SELECT id, duration_min FROM services WHERE id = ? AND active = 1', [serviceId]);
    if (!service) return sendError(res, 404, 'NOT_FOUND', 'Услуга не найдена');

    // Валидация формата времени
    const startD = new Date(start), endD = new Date(end);
    if (isNaN(startD) || isNaN(endD) || endD <= startD) return sendError(res, 400, 'VALIDATION', 'Некорректные дата/время');
    // Длительность должна соответствовать услуге (сервер определяет, не клиент)
    const expectedEnd = new Date(startD.getTime() + service.duration_min * 60000);
    if (Math.abs(expectedEnd.getTime() - endD.getTime()) > 60000) {
      return sendError(res, 400, 'VALIDATION', `Длительность должна быть ${service.duration_min} мин`);
    }
    // Не в прошлом
    if (startD.getTime() < Date.now() - 60000) return sendError(res, 400, 'VALIDATION', 'Нельзя записаться в прошлое');
    // Услуга должна целиком уложиться в рабочие часы мастера на этот день
    // (совпадает с логикой slotStatuses: иначе слот 'tooshort' прошёл бы мимо проверки).
    const dDow = new Date(startD.toISOString().slice(0, 10) + 'T00:00:00Z').getUTCDay();
    const schedRow = get('SELECT work_end FROM schedule WHERE master_id = ? AND day_of_week = ?', [masterId, dDow]);
    const mRow = get('SELECT work_end FROM masters WHERE id = ?', [masterId]);
    const dayEnd = (schedRow && schedRow.work_end) || (mRow && mRow.work_end) || '19:00';
    if (endD.toISOString().slice(11, 16) > dayEnd) {
      return sendError(res, 400, 'VALIDATION', `Услуга должна закончиться не позже ${dayEnd} (конец рабочего дня)`);
    }

    // Кто создаёт запись?
    // client: запись на себя. master: на своего клиента (client_id из body, но только свой master_id).
    // admin: может указать client_id и force_overlap.
    let clientId = req.user.id;
    let forceOverlap = 0;
    if (req.user.role === 'client') {
      clientId = req.user.id; // клиент не может записать другого
    } else if (req.user.role === 'master') {
      // мастер работает ТОЛЬКО со своим расписанием (п.13). Игнорируем masterId из body.
      const myMaster = get('SELECT id FROM masters WHERE user_id = ?', [req.user.id]);
      if (!myMaster) return sendError(res, 403, 'FORBIDDEN', 'Мастер не привязан к профилю');
      masterId = myMaster.id;
      clientId = Number(req.body.clientId) || req.user.id;
    } else if (req.user.role === 'admin') {
      clientId = Number(req.body.clientId) || req.user.id;
      forceOverlap = req.body.forceOverlap ? 1 : 0; // только admin может
    }

    const result = createBooking({
      clientId, masterId: Number(masterId), serviceId: Number(serviceId),
      startISO: startD.toISOString(), endISO: endD.toISOString(),
      createdBy: req.user.id, forceOverlap,
    });

    if (!result.ok) {
      if (result.code === 'SLOT_UNAVAILABLE') return res.status(409).json({ error: 'SLOT_UNAVAILABLE', message: result.message, availableSlots: result.availableSlots });
      return sendError(res, 500, result.code, result.message);
    }
    const b = get('SELECT * FROM bookings WHERE id = ?', [result.bookingId]);
    return res.status(201).json({ booking: cleanBooking(b) });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});

function isMasterLinkedToMaster(userId, masterId) {
  const m = get('SELECT id FROM masters WHERE id = ? AND user_id = ?', [masterId, userId]);
  return !!m;
}

function cleanBooking(b) {
  return {
    id: b.id, clientId: b.client_id, masterId: b.master_id, serviceId: b.service_id,
    start: b.start_time, end: b.end_time, status: b.status, createdBy: b.created_by,
    clientName: b.client_name, masterName: b.master_name, serviceName: b.service_name,
  };
}

// Свои записи (клиент — только свои; мастер — свои; admin — все)
app.get('/api/bookings', authenticateToken, (req, res) => {
  let rows;
  if (req.user.role === 'admin') {
    rows = all(`SELECT b.*, u.name AS client_name, m.name AS master_name, s.name AS service_name
                FROM bookings b
                LEFT JOIN users u ON u.id = b.client_id
                LEFT JOIN masters m ON m.id = b.master_id
                LEFT JOIN services s ON s.id = b.service_id
                ORDER BY b.start_time DESC`);
  } else if (req.user.role === 'master') {
    const m = get('SELECT id FROM masters WHERE user_id = ?', [req.user.id]);
    const mid = m ? m.id : -1;
    rows = all(`SELECT b.*, u.name AS client_name, m.name AS master_name, s.name AS service_name
                FROM bookings b
                LEFT JOIN users u ON u.id = b.client_id
                LEFT JOIN masters m ON m.id = b.master_id
                LEFT JOIN services s ON s.id = b.service_id
                WHERE b.master_id = ? ORDER BY b.start_time DESC`, [mid]);
  } else {
    rows = all(`SELECT b.*, u.name AS client_name, m.name AS master_name, s.name AS service_name
                FROM bookings b
                LEFT JOIN users u ON u.id = b.client_id
                LEFT JOIN masters m ON m.id = b.master_id
                LEFT JOIN services s ON s.id = b.service_id
                WHERE b.client_id = ? ORDER BY b.start_time DESC`, [req.user.id]);
  }
  res.json({ bookings: rows.map(cleanBooking) });
});

// Конкретная запись — проверка владельца (п.22)
app.get('/api/bookings/:id', authenticateToken, (req, res) => {
  const b = get('SELECT * FROM bookings WHERE id = ?', [req.params.id]);
  if (!b) return sendError(res, 404, 'NOT_FOUND', 'Запись не найдена');

  const isClientOwner = req.user.role === 'client' && Number(req.user.id) === Number(b.client_id);
  const isMasterOf = req.user.role === 'master' && masterBelongsToUser(req.user.id, b.master_id);
  const isAdmin = req.user.role === 'admin';
  if (!isClientOwner && !isMasterOf && !isAdmin) {
    // не раскрываем существование чужой записи -> 404
    return sendError(res, 404, 'NOT_FOUND', 'Запись не найдена');
  }
  res.json({ booking: cleanBooking(b) });
});

function masterBelongsToUser(userId, masterId) {
  const m = get('SELECT id FROM masters WHERE id = ? AND user_id = ?', [masterId, userId]);
  return !!m;
}

app.delete('/api/bookings/:id', authenticateToken, (req, res) => {
  const bookingId = Number(req.params.id);
  const booking = get('SELECT * FROM bookings WHERE id = ?', [bookingId]);
  if (!booking) return sendError(res, 404, 'NOT_FOUND', 'Запись не найдена');
  if (req.user.role === 'client' && Number(req.user.id) !== Number(booking.client_id)) {
    return sendError(res, 403, 'FORBIDDEN', 'Нет прав на отмену этой записи');
  }
  const result = cancelBooking(bookingId, req.user);
  if (!result.ok) return sendError(res, result.status || 400, result.code, result.message);
  res.json({ message: 'Запись отменена' });
});

// ============ ADMIN ============
app.get('/api/admin/bookings', authenticateToken, requireRole('admin'), (req, res) => {
  const rows = all(`SELECT b.*, u.name AS client_name, m.name AS master_name, s.name AS service_name
                    FROM bookings b
                    LEFT JOIN users u ON u.id = b.client_id
                    LEFT JOIN masters m ON m.id = b.master_id
                    LEFT JOIN services s ON s.id = b.service_id
                    ORDER BY b.start_time DESC`);
  res.json({ bookings: rows.map(cleanBooking) });
});
app.get('/api/admin/users', authenticateToken, requireRole('admin'), (req, res) => {
  const rows = all('SELECT id, name, email, role, created_at FROM users ORDER BY id');
  res.json({ users: rows });
});
app.get('/api/admin/masters', authenticateToken, requireRole('admin'), (req, res) => {
  const rows = all('SELECT id, user_id, name, specialization, active FROM masters ORDER BY id');
  res.json({ masters: rows });
});
app.get('/api/admin/services', authenticateToken, requireRole('admin'), (req, res) => {
  const rows = all('SELECT id, name, duration_min, price, active FROM services ORDER BY id');
  res.json({ services: rows });
});
app.get('/api/admin/schedule', authenticateToken, requireRole('admin'), (req, res) => {
  const rows = all(`SELECT s.*, m.name AS master_name, s.day_of_week, s.work_start, s.work_end, s.active
                    FROM schedule s
                    LEFT JOIN masters m ON m.id = s.master_id
                    ORDER BY s.master_id, s.day_of_week`);
  res.json({ schedule: rows });
});
// Связи мастер <-> услуга
app.get('/api/admin/master-services', authenticateToken, requireRole('admin'), (req, res) => {
  const rows = all('SELECT master_id, service_id FROM master_services');
  res.json({ links: rows });
});
app.post('/api/admin/master-services', authenticateToken, requireRole('admin'), (req, res) => {
  try {
    const { masterId, serviceId } = req.body || {};
    if (!masterId || !serviceId) return sendError(res, 400, 'VALIDATION', 'masterId и serviceId обязательны');
    const ex = get('SELECT id FROM master_services WHERE master_id = ? AND service_id = ?', [masterId, serviceId]);
    if (ex) return res.json({ ok: true, already: true });
    run('INSERT INTO master_services (master_id, service_id) VALUES (?, ?)', [masterId, serviceId]);
    return res.status(201).json({ ok: true });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});
app.delete('/api/admin/master-services', authenticateToken, requireRole('admin'), (req, res) => {
  try {
    const { masterId, serviceId } = req.body || {};
    if (!masterId || !serviceId) return sendError(res, 400, 'VALIDATION', 'masterId и serviceId обязательны');
    run('DELETE FROM master_services WHERE master_id = ? AND service_id = ?', [masterId, serviceId]);
    return res.json({ ok: true });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});
// Создание мастера
app.post('/api/admin/masters', authenticateToken, requireRole('admin'), (req, res) => {
  try {
    const { name, specialization, photo_url, work_start, work_end, serviceIds } = req.body || {};
    if (!name || typeof name !== 'string' || name.trim().length < 2)
      return sendError(res, 400, 'VALIDATION', 'Имя мастера обязательно');
    const r = run(
      'INSERT INTO masters (name, specialization, photo_url, work_start, work_end, active) VALUES (?,?,?,?,?,1)',
      [name.trim(), specialization || '', photo_url || '', work_start || '10:00', work_end || '19:00']
    );
    const masterId = Number(r.lastInsertRowid);
    // привязываем услуги
    if (Array.isArray(serviceIds)) {
      for (const sid of serviceIds) {
        const s = get('SELECT id FROM services WHERE id = ?', [sid]);
        if (s) run('INSERT OR IGNORE INTO master_services (master_id, service_id) VALUES (?, ?)', [masterId, sid]);
      }
    }
    // график на все дни
    for (let dow = 0; dow < 7; dow++) {
      const ex = get('SELECT id FROM schedule WHERE master_id = ? AND day_of_week = ?', [masterId, dow]);
      if (!ex) run('INSERT INTO schedule (master_id, day_of_week, work_start, work_end) VALUES (?,?,?,?)', [masterId, dow, work_start || '10:00', work_end || '19:00']);
    }
    return res.status(201).json({ ok: true, masterId });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});
// Создание услуги
app.post('/api/admin/services', authenticateToken, requireRole('admin'), (req, res) => {
  try {
    const { name, description, duration_min, price } = req.body || {};
    if (!name || typeof name !== 'string' || name.trim().length < 2)
      return sendError(res, 400, 'VALIDATION', 'Название услуги обязательно');
    if (!duration_min || !price) return sendError(res, 400, 'VALIDATION', 'Укажите длительность и цену');
    const r = run(
      'INSERT INTO services (name, description, duration_min, price, active) VALUES (?,?,?,?,1)',
      [name.trim(), description || '', Number(duration_min), Number(price)]
    );
    return res.status(201).json({ ok: true, serviceId: Number(r.lastInsertRowid) });
  } catch (e) {
    return sendError(res, 500, 'INTERNAL', 'Внутренняя ошибка');
  }
});


