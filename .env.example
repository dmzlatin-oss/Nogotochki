# Пример файла окружения для Ноготочки
# Скопируйте в .env и заполните своими значениями

# Порт бэкенда (по умолчанию 3000, в проекте используется 3001)
PORT=3001

# Путь к файлу базы данных SQLite
DATABASE_PATH=src/db/booking.db

# Секретный ключ для JWT-токенов (длиной минимум 32 символа)
# Генерируется командой: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ваш_секретный_ключ_здесь

# (Опционально) Соль для паролей — если используется фиксированная соль
# В данном проекте соль генерируется случайно при регистрации, поэтому не требуется

# (Опционально) Префикс API (если используется nginx-проксирование)
# Не используется в данном проекте
# API_PREFIX=/api

# (Опционально) Режим отладки
DEBUG=false

# (Опционально) Лимиты rate limiting (по умолчанию 5 запросов в минуту)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# (Опционально) Настройки соединения с базой данных (для будущего перехода на PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nogotochki
# DB_USER=nogotochki_user
# DB_PASSWORD=
